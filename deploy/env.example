# Copie para /opt/sgm/.env na VPS (o vps-setup.sh já faz isso) e preencha.
# Este arquivo NÃO é o .env do repositório: aqui ficam as variáveis de RUNTIME do servidor Node,
# lidas pelas 60 funções portadas em src/lib/edge/fns. Nunca coloque a SERVICE_ROLE_KEY no repositório.

# --- Caddy ---
# Domínio com HTTPS automático (Let's Encrypt). Sem domínio próprio, use <ip-com-hifens>.sslip.io
# (ex.: 136-0-53-217.sslip.io), que resolve para o próprio IP e também recebe certificado.
# Não use só ":80" (http://IP): fora de HTTPS o navegador bloqueia crypto.randomUUID, crypto.subtle,
# câmera e área de transferência, e uploads, assinaturas e vários cadastros do SGM param de funcionar.
SITE_ADDRESS=136-0-53-217.sslip.io

# --- Supabase (projeto no Supabase Cloud) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# URL pública do sistema, usada em links de e-mail e redirecionamentos.
APP_ORIGIN=https://136-0-53-217.sslip.io
APP_BASE_URL=https://136-0-53-217.sslip.io

# --- Integrações (valores que você já tem guardados) ---
PLUGSEND_TOKEN=
BRASILNFE_TOKEN=
# Segredo que assina os JWTs do portal do fornecedor/candidato (string longa aleatória).
PORTAL_JWT_SECRET=
# Segredo que o BrasilNFe envia no webhook de NF-e (nfe-webhook).
NFE_WEBHOOK_SECRET=

# --- IA (Google Gemini) ---
# Chave criada no Google AI Studio (https://aistudio.google.com/apikey). Usada pela Duda, pela leitura
# de editais, propostas, holerites e datas de documentos e pela busca da Base de Conhecimento.
# Vazia = essas telas mostram "GEMINI_API_KEY não configurada".
GEMINI_API_KEY=
# Opcional: trocar os modelos sem mexer no código. Vazio = padrão: gemini-3.5-flash-lite nas tarefas
# rápidas e gemini-3.8-flash na análise de editais e nas perguntas analíticas da Duda.
GEMINI_MODEL_RAPIDO=
GEMINI_MODEL_AVANCADO=

# --- E-mails transacionais (Resend) ---
# Chave criada em https://resend.com/api-keys (permissão "Sending access").
# Vazia = OTP de assinatura, senha temporária, avisos de compras/férias e cotações não saem.
RESEND_API_KEY=
# Remetente de todos os e-mails. O domínio depois do @ precisa estar verificado no Resend (Domains).
# Mantenha as aspas: o valor tem espaços e < >.
EMAIL_FROM="SGM Lasant <noreply@mail.lasant.com.br>"
# Opcional: segredo do webhook do Resend (whsec_...), para gravar bounces e reclamações de spam em
# suppressed_emails/email_send_log. Endpoint: https://<site>/api/public/edge/handle-email-events
RESEND_WEBHOOK_SECRET=
# Opcional: só se ativar o hook "Send Email" no Supabase Auth (v1,whsec_...).
# Endpoint: https://<site>/api/public/edge/auth-email-hook
SEND_EMAIL_HOOK_SECRET=
